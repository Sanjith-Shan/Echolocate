# Copy to .env and fill in. None of these are required for local dev — the
# pipeline runs in stub mode if Anthropic / VAPID are unset.

# CSI source. Three valid forms:
#   /dev/cu.usbmodem14101    real ESP32 over USB serial
#   tcp://127.0.0.1:3333     simulator (run: python -m sim.esp32_sim)
#   file:///abs/path/cap.csv replay a captured serial dump
SERIAL_PORT=tcp://127.0.0.1:3333
SERIAL_BAUD=921600

# Claude (optional — pipeline uses stub responses without it)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Web Push (optional)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:dev@example.com

# Camera
CAMERA_DEVICE_INDEX=1

# Tuning
SNAPSHOT_COOLDOWN=30
ECHOLOCATE_DB=echolocate.db
